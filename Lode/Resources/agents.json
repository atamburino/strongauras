{
  "agents": [
    {
      "name": "Claude Code",
      "process_name": "claude",
      "match_type": "name"
    },
    {
      "name": "Codex CLI",
      "process_name": "codex",
      "match_type": "name"
    },
    {
      "name": "GitHub CLI",
      "process_name": "gh",
